{
  "name": "dsh-assist-chat",
  "version": "0.1.2",
  "description": "在右侧栏开一条当前对话的分支，追问不打断主线。Side chat for DeepSeek Harness: branch the current conversation into the right dock.",
  "type": "module",
  "license": "MIT",
  "icon": "./assets/icon-180.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "side-chat",
    "assist",
    "sidebar",
    "fork",
    "conversation"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "test/*.cjs",
    "CHANGELOG.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node test/smoke.cjs",
    "check": "node --check client.js",
    "prepublishOnly": "node --check client.js && node test/smoke.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "sleep123937 <zousleep@163.com> (https://github.com/sleep123937)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sleep123937/dsh-assist-chat.git"
  },
  "homepage": "https://github.com/sleep123937/dsh-assist-chat#readme",
  "bugs": {
    "url": "https://github.com/sleep123937/dsh-assist-chat/issues"
  }
}
